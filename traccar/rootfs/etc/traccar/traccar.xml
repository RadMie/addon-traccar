<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>

<properties>

    <!--
    Add only settings that should override the Home Assistant defaults.
    The add-on merges this file into an ephemeral runtime config at startup.

    Configuration reference:
        https://www.traccar.org/configuration-file/
    -->

    <!--
    OsmAnd is enabled by default. To enable another device protocol, list all
    required protocol names here. Built-in ports are used unless overridden.

    Example for OsmAnd and Teltonika:
    <entry key='protocols.enable'>osmand,teltonika</entry>
    <entry key='teltonika.port'>5027</entry>

    Device/protocol finder:
        https://www.traccar.org/devices/
    -->

</properties>
